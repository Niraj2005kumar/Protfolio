{
  "name": "niraj-verma-portfolio",
  "version": "1.0.0",
  "type": "module",
  "description": "Premium AI Portfolio Website for Niraj Verma",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "postinstall": "node -e \"const fs=require('fs'),p='./node_modules/.bin';if(fs.existsSync(p)){fs.readdirSync(p).forEach(f=>{try{fs.chmodSync(p+'/'+f,0o755)}catch(e){}})}\""
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "vite": "^5.4.14"
  }
}