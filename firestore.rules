rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAdmin() {
      return request.auth != null;
    }

    // Profile details can be read by anyone, but updated only by admin
    match /profile/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects list can be read by anyone, updated only by admin
    match /projects/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Skills can be read by anyone, updated only by admin
    match /skills/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificates can be read by anyone, updated only by admin
    match /certificates/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Messages can be created by visitors (write), but read/deleted only by admin
    match /messages/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Analytics can be updated/created by visitors (page view increments), read/deleted only by admin
    match /analytics/{document} {
      allow read, delete: if isAdmin();
      allow create, update: if true;
    }

    // Settings can be read by anyone, updated only by admin
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
